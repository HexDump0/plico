{
	"name": "plico",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "npm run build:wasm",
		"dev": "vite dev",
		"prebuild": "npm run build:wasm",
		"build": "vite build",
		"build:wasm": "wasm-pack build rust/plico-engine --target web --out-dir ../../src/lib/pdf/wasm --out-name plico_engine --no-pack --no-opt",
		"test:engine": "cargo test",
		"test:corpus": "cargo test --release --test corpus -- --ignored --nocapture",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run build:wasm",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@fontsource/fira-code": "^5.3.0",
		"@tabler/icons-svelte-runes": "^3.46.0",
		"gsap": "^3.15.0",
		"pdfjs-dist": "^6.3.289"
	}
}
